# =============================================================================
# .gitignore — Unit Economics Intelligence Platform
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
env/
venv/
.venv/
ENV/

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Data Files (raw & processed CSVs/DB — not for version control) ───────────
data/raw/*.csv
data/processed/*.csv
data/outputs/*.csv
data/outputs/*.png
data/*.db
*.sqlite
*.sqlite3

# ── OS & Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Keep folder structure ─────────────────────────────────────────────────────
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/outputs/.gitkeep